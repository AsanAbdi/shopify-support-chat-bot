# Production environment for AWS. Copy to .env.prod (git-ignored), fill in, then upload to SSM:
#   infra/aws/scripts/put-secrets.sh .env.prod --region eu-central-1 --prefix /shop-support/prod
# Generate secrets with:  openssl rand -hex 32

APP_ENV=prod
DOMAIN=support.your-shop.com
ACME_EMAIL=ops@your-shop.com
PUBLIC_BASE_URL=https://support.your-shop.com
CORS_ORIGINS=["https://your-shop.com","https://www.your-shop.com"]

POSTGRES_USER=app
POSTGRES_DB=app
POSTGRES_PASSWORD=
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- LLM. Option A: Claude on Amazon Bedrock inside AWS (EU), no API key, needs enable_bedrock = true in Terraform
LLM_PROVIDER=bedrock
LLM_MODEL=eu.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_REGION=eu-central-1
# ---- Option B: Anthropic API
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=
LLM_PRICE_IN_EUR_PER_MTOK=0.92
LLM_PRICE_OUT_EUR_PER_MTOK=4.60
LLM_MONTHLY_BUDGET_EUR=100

# ---- Integrations
SHOPIFY_BASE_URL=https://your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_STOREFRONT_URL=https://your-shop.com
FRESHDESK_BASE_URL=https://your-domain.freshdesk.com
FRESHDESK_API_KEY=
SUPPORT_EMAIL=support@your-shop.com
ESCALATION_SLA_HOURS=24

# ---- Observability and alerts (optional)
# SENTRY_DSN=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# ALERT_WEBHOOK_URL=
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=

# ---- DEMO deployment with the built-in mocks instead of real Shopify/Freshdesk (no real orders or tickets):
# COMPOSE_PROFILES=mock,demo
# ALLOW_MOCK_INTEGRATIONS=true
# SHOPIFY_BASE_URL=http://mock-services:9000
# SHOPIFY_ADMIN_TOKEN=mock-shopify-token
# FRESHDESK_BASE_URL=http://mock-services:9000/freshdesk
# FRESHDESK_API_KEY=mock-freshdesk-key
# URL_FETCH_ALLOW_PRIVATE=true
