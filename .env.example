# Copy to .env. Everything has a working default for local Docker runs with mocks.

# --- ports on the host ---
API_PORT=8088

# --- database ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# --- app ---
APP_ENV=dev                       # dev | prod (prod refuses default secrets)
PUBLIC_BASE_URL=http://localhost:8088
CORS_ORIGINS=["*"]                # prod: ["https://your-shop.com"]
JWT_SECRET=change-me-in-env       # openssl rand -hex 32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345         # initial admin, change it
URL_FETCH_ALLOW_PRIVATE=true      # dev only: allows indexing URLs on the docker network (SSRF guard otherwise)

# --- LLM: switch provider/model here, no code changes ---
LLM_PROVIDER=fake                 # fake (offline rule-based) | anthropic | openai | bedrock (Claude inside AWS, IAM role, no key)
# bedrock: LLM_MODEL=eu.anthropic.claude-haiku-4-5-20251001-v1:0  AWS_REGION=eu-central-1  (see infra/aws/README.md)
LLM_MODEL=claude-haiku-4-5-20251001
# LLM_SUMMARY_MODEL=              # optional cheaper model for summaries
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
LLM_PRICE_IN_EUR_PER_MTOK=0.92    # used for the EUR cost stats and the budget guard
LLM_PRICE_OUT_EUR_PER_MTOK=4.60
LLM_MONTHLY_BUDGET_EUR=100
LLM_BUDGET_ALERT_RATIO=0.8

# --- embeddings (local multilingual model, baked into the image) ---
EMBEDDINGS_PROVIDER=fastembed     # fastembed | fake
# Default model: intfloat/multilingual-e5-large (1024 dim, ~2.3 GB RAM per process, ~90 ms per query on 1 CPU thread).
# Lighter alternative: sentence-transformers/paraphrase-multilingual-mpnet-base-v2 -> EMBEDDINGS_DIM=768, empty prefixes,
# a new threshold, a migration and `POST /api/admin/reindex-all`.
# RETRIEVAL_MIN_SIMILARITY=0.82   # "nothing found" gate; MODEL SPECIFIC, recalibrate after changing the model (make calibrate)
# PRODUCT_MIN_SIMILARITY=0.76
RERANKER=none                     # none | fastembed. The multilingual cross-encoder costs 1.5-3.5 s per query on CPU: leave off
RETRIEVAL_MIN_RERANK=0.15         # gate when the reranker is on

# --- Shopify / Freshdesk: mocks by default ---
SHOPIFY_BASE_URL=http://mock-services:9000
SHOPIFY_ADMIN_TOKEN=mock-shopify-token
SHOPIFY_STOREFRONT_URL=https://demo-store.example.com
SHOPIFY_API_VERSION=2026-07       # Admin API version, update every ~6-9 months
FRESHDESK_BASE_URL=http://mock-services:9000/freshdesk
FRESHDESK_API_KEY=mock-freshdesk-key
# real: SHOPIFY_BASE_URL=https://<store>.myshopify.com  FRESHDESK_BASE_URL=https://<domain>.freshdesk.com
SUPPORT_EMAIL=support@demo-store.example.com
ESCALATION_SLA_HOURS=24

# --- observability (optional) ---
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com   # use the EU region for GDPR

# --- prod (docker-compose.prod.yml) ---
# DOMAIN=support.your-shop.com
# ACME_EMAIL=ops@your-shop.com

# --- alerts (optional; Sentry also gets budget alerts) ---
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...        # Slack/Mattermost/Teams-compatible
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
